{
  "name": "clipdeck",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first replay buffer and clip editor. No accounts, no cloud, no telemetry.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cargo:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "cargo:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "cargo:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm cargo:fmt:check && pnpm cargo:clippy && pnpm cargo:test",
    "fetch:ffmpeg": "pwsh -NoProfile -File scripts/fetch-ffmpeg.ps1",
    "package:portable": "pwsh -NoProfile -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
